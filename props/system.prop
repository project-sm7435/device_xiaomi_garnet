# CNE
persist.vendor.cne.feature=1

# Device
ro.product.mod_device=garnet_global

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
DEVICE_PROVISIONED=1
persist.vendor.data.mode=concurrent
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1

# Radio VoNR Calling
persist.radio.is_vonr_enabled_0=true
persist.radio.is_vonr_enabled_1=true
persist.vendor.vonr_setting_support=1

# Blur
ro.sf.blurs_are_expensive=1
ro.launcher.blur.appLaunch=0

# HWUI
ro.hwui.render_ahead=1
ro.hwui.drop_shadow_cache_size=6
ro.hwui.gradient_cache_size=1
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.r_buffer_cache_size=8
ro.hwui.text_large_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_small_cache_height=1024
ro.hwui.text_small_cache_width=1024
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.texture_cache_size=72
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=30
debug.hwui.show_overdraw=false
debug.renderengine.blur_algorithm=kawase2
debug.hwui.use_triple_buffering=true

# Logging
persist.log.tag.HWUI=S
debug.egl.profiler=0
debug.hwc.otf=0
debug.hwc_dump_en=0
debug.sf.dump=0
debug.sf.ddms=0
debug.sf.recomputecrop=0
debug.sf.showupdates=0
debug.sf.showcpu=0
debug.sf.showbackground=0
debug.sf.showfps=0
debug.enable.gamed=0
debug.enable.wl_log=0
debugtool.anrhistory=0
debug.atrace.tags.enableflags=0
debug.kill_allocating_task=0
debug_test=0
media.stagefright.log-uri=0
vidc.debug.level=0
profiler.debugmonitor=false
profiler.launch=false
profiler.hung.dumpdobugreport=false
ro.config.nocheckin=1
profiler.force_disable_err_rpt=1
profiler.force_disable_ulog=1

# Battery Logging
ro.sf.battery_log=0
ro.sf.battery.log.enabled=0

# IMS Logging
persist.ims.disableDebugLogs=1
persist.ims.enableADBLogs=0
persist.ims.enableDebugLogs=0
persist.ims.disableQXDMLogs=1
persist.ims.disableIMSLogs=1

# Broadcom
persist.brcm.log=none
persist.brcm.cp_crash=none
persist.brcm.ap_crash=none

# OEM & Radio
persist.sys.dun.override=0
persist.radio.oem_socket=false
persist.oem.dump=0

# Offline Logging
persist.sys.offlinelog.kernel=0
persist.sys.offlinelog.logcat=0

# Service Logging
persist.service.pcsync.enable=0
persist.service.lgospd.enable=0
persist.service.logging.disable=true

# Memory
libc.debug.malloc=0

# SSR
persist.vendor.ssr.enable_ramdumps=0

# Kernel
ro.kernel.qemu.gles=0

# Detailed Log Outputs
log.resolves=0
log.pm4=0
log.pm4mem=0
log.shaders=0
log.sc_dev=0
log.cffdump=0
log.cffdump_with_ifh=0
log.cffdump_no_memzero=0
log.dumpx=0
log.primitives=0
log_frame_info=0
log_mp4dectime=0
log_posttime=0
log_profile=0
log_playerdriver=0
log_metadatadriver=0
log_playerengine=0
log_datapath=0
log_mp4parsernode=0
log_basedecnode=0
log_audiodecnode=0
log_videodecnode=0
log_outputnode=0
log_outputnodeinputport=0
log_audiooutput=0
log_surfaceoutput=0
log_omxmp4=0
log_ao=0
log_fps_interval=0

# JNI checks
ro.kernel.android.checkjni=0
ro.kernel.checkjni=0
dalvik.vm.checkjni=false

# RIL / Modem power saving
ro.ril.disable.power.collapse=0
ro.ril.power_collapse=1

# Misc
config.disable_rtt=true
db.log.slow_query_threshold=-1
ro.config.small_battery=true

#surface_flinger
ro.surface_flinger.support_kernel_idle_timer=true
