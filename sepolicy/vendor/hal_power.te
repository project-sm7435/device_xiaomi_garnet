allow hal_power_default touchfeature_device:chr_file rw_file_perms;

# ADPF updates app threads across per-app MLS categories.
typeattribute hal_power_default mlstrustedsubject;

# Apply per-thread uclamp for app and SurfaceFlinger hint sessions.
allow hal_power_default self:global_capability_class_set sys_nice;
allow hal_power_default { appdomain surfaceflinger }:process setsched;
