allow vendor_init cgroup:file r_file_perms;

set_prop(vendor_init, vendor_fp_prop)
set_prop(vendor_init, vendor_qcc_prop)

allow init vendor_sysfs_sd:file write;

# Bluetooth
set_prop(vendor_init, vendor_bt_stack_prop)

allow vendor_init proc_swappiness:file w_file_perms;
allow init proc_swappiness:file w_file_perms;
