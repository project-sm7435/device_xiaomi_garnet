# Configure uclamp
on property:persist.sys.device_provisioned=1 && property:sys.boot_completed=1
    write /dev/cpuctl/background/cpu.uclamp.max 50
    write /dev/cpuctl/system-background/cpu.uclamp.max 50
    write /dev/cpuctl/dex2oat/cpu.uclamp.max 60

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 691200
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 691200

# Set WALT early
on boot
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor walt
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor walt

# Grant Power HAL access to CPU scaling nodes
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq

    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq

    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 691200
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 691200

# Grant Power HAL access to core_ctl
    chown system system /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu0/core_ctl/min_cpus
    chown system system /sys/devices/system/cpu/cpu4/core_ctl/min_cpus
    chmod 0664 /sys/devices/system/cpu/cpu4/core_ctl/min_cpus
